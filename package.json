{
  "name": "luo-fe-prompt-manager",
  "version": "1.3.0",
  "description": "Luo-fe本地提示词管理器 - AI文生图提示词工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis",
    "build:all": "electron-builder --win",
    "build:portable-fast": "electron-builder --win dir && powershell -Command \"Compress-Archive -Path 'dist/win-unpacked/*' -DestinationPath 'dist/Luo-fe本地提示词管理器_v1.3_便携版.zip' -Force\""
  },
  "author": "Luo-fe",
  "productName": "Luo-fe的本地提示词管理器",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.luofe.prompt-manager",
    "productName": "Luo-fe的本地提示词管理器",
    "afterPack": "./afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/splash.html",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Luo-fe本地提示词管理器_v1.3_便携版.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luo-fe的本地提示词管理器",
      "artifactName": "Luo-fe本地提示词管理器_v1.3_安装版.exe",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "asarUnpack": [],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
